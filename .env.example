PORT=4000
JWT_SECRET=replace-with-a-long-random-string
NODE_ENV=development

# MySQL (required)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=stylearz
MYSQL_PASSWORD=
MYSQL_DATABASE=stylearz

# POS invoice SMS (optional). Default "log" writes to the server console.
# Save the billed sender mobile in Admin → Settings (smsSenderPhone).
# SMS_PROVIDER=log|http|twilio
SMS_PROVIDER=log
# SMS_HTTP_URL=https://your-bd-sms-gateway.example/send
# SMS_HTTP_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
